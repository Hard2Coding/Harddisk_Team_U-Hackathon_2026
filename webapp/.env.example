# ScamLens AI — Environment Variables
# For local development: copy this to .env.local and fill in your API key.
# For Vercel production: add these in Project Settings -> Environment Variables.

# 1. Google Gemini API Key (from https://aistudio.google.com)
GEMINI_API_KEY=

# 2. Gemini Model ID (defaults to gemini-2.5-flash)
# Options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash
